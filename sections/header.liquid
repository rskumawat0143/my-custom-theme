<header class="custom-header">

  <div class="custom-header-container">
<div style="display: flex; flex-wrap: wrap; flex: 1; align-items: center;">
   {% for block in section.blocks %}
      {% render block %}
    {% endfor %}
</div>

    <!-- Header Actions -->
    <div class="custom-header-actions">

      <!-- Search -->
      <a
        href="{{ routes.search_url }}"
        class="header-icon"
        aria-label="Search">
        🔍
      </a>


      <!-- Account -->
      {% if shop.customer_accounts_enabled %}

        <a
          href="{{ routes.account_url }}"
          class="header-icon"
          aria-label="Account">
          👤
        </a>

      {% endif %}


      <!-- Cart -->
      <a
        href="{{ routes.cart_url }}"
        class="header-icon cart-icon"
        aria-label="Cart">

        🛒

        {% if cart.item_count > 0 %}

          <span class="cart-count">
            {{ cart.item_count }}
          </span>

        {% endif %}

      </a>

    </div>


    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="mobile-menu-button"
      onclick="document.querySelector('.custom-header-nav').classList.toggle('active')"
      aria-label="Open menu">
      ☰
    </button>

  </div>

</header>


<style>

  .custom-header {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e5e5e5;
    position: relative;
    z-index: 100;
  }

  .custom-header-container {
    max-width: 1200px;
    min-height: 80px;
    margin: 0 auto;
    padding: 0 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }


  /* Logo */

  .custom-header-logo {
    flex-shrink: 0;
  }

  .custom-header-logo a {
    display: flex;
    align-items: center;
    color: #000000;
    text-decoration: none;
    font-size: 24px;
    font-weight: 700;
  }

  .custom-header-logo img {
    display: block;
    max-width: 180px;
    max-height: 60px;
    width: auto;
    height: auto;
  }


  /* Navigation */

  .custom-header-nav {
    flex: 1;
  }

  .custom-header-nav > ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;

    margin: 0;
    padding: 0;
    list-style: none;
  }

  .custom-header-nav li {
    position: relative;
  }

  .custom-header-nav a {
    display: block;
    padding: 10px 0;

    color: #000000;
    text-decoration: none;

    font-size: 15px;
    font-weight: 500;
  }

  .custom-header-nav a:hover {
    opacity: 0.6;
  }


  /* Dropdown */

  .custom-submenu {
    position: absolute;
    top: 100%;
    left: 0;

    min-width: 200px;
    padding: 10px 0;

    background: #ffffff;
    border: 1px solid #e5e5e5;

    list-style: none;

    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);

    transition: all 0.2s ease;
  }

  .custom-header-nav li:hover > .custom-submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .custom-submenu li a {
    padding: 10px 15px;
    white-space: nowrap;
  }


  /* Actions */

  .custom-header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .header-icon {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #000000;
    text-decoration: none;

    font-size: 20px;
  }

  .cart-count {
    position: absolute;
    top: -8px;
    right: -10px;

    min-width: 18px;
    height: 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #000000;
    color: #ffffff;

    font-size: 10px;
    line-height: 1;
  }


  /* Mobile Button */

  .mobile-menu-button {
    display: none;

    padding: 5px;

    border: 0;
    background: transparent;

    font-size: 25px;
    cursor: pointer;
  }


  /* Tablet */

  @media screen and (max-width: 989px) {

    .custom-header-container {
      gap: 20px;
    }

    .custom-header-nav > ul {
      gap: 18px;
    }

  }


  /* Mobile */

  @media screen and (max-width: 749px) {

    .custom-header-container {
      min-height: 65px;
      padding: 0 15px;
    }

    .custom-header-nav {
      display: none;

      position: absolute;
      top: 100%;
      left: 0;
      right: 0;

      padding: 15px 20px;

      background: #ffffff;
      border-bottom: 1px solid #e5e5e5;
    }

    .custom-header-nav.active {
      display: block;
    }

    .custom-header-nav > ul {
      display: block;
    }

    .custom-header-nav > ul > li {
      border-bottom: 1px solid #eeeeee;
    }

    .custom-header-nav a {
      padding: 12px 0;
    }

    .custom-submenu {
      position: static;

      display: block;

      padding: 0 0 0 15px;

      border: 0;

      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .custom-header-actions {
      margin-left: auto;
      gap: 12px;
    }

    .mobile-menu-button {
      display: block;
    }

  }

</style>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color"
      }, {
        "type": "text",
        "id": "padding",
        "label": "Padding",
        "info": "10px 10px 10px 10px"
      }, {
        "type": "select",
        "id": "column_count",
        "label": "Column",
        "options": [
            {
                "value": "1",
                "label": "1"
            },
            {
                "value": "2",
                "label": "2"
            },
            {
                "value": "3",
                "label": "3"
            },
            {
                "value": "4",
                "label": "4"
            }
        ],
        "default": "1"
      }
    ],
    "blocks": [
      {
        "type": "navigation"
      },
      {
        "type": "logo"
      },
      {
        "type": "column"
      }
    ]
  }
{% endschema %}
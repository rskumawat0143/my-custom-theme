{% paginate collection.products by section.settings.products_per_page %}
  <div class="page-width">
    <div class="product-grid">
      {% for product in collection.products %}
        {% render 'card-product', product: product %}
      {% else %}
        <p class="no-products">No products found in this collection.</p>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <div class="pagination">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  </div>
{% endpaginate %}

{% style %}
  .page-width {
    max-width: {{section.settings.width}}px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat({{section.settings.grid_column}}, 1fr);
    gap: 30px;
    padding: 40px 0;
  }
  .no-products {
    text-align: center;
    grid-column: 1 / -1;
    font-size: 18px;
    color: #666;
    padding: 50px 0;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .product-card:hover {
    transform: translateY(-5px);
  }
  .product-image {
    display: block;
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .product-card:hover .product-image img {
    transform: scale(1.05);
  }
  .product-info {
    padding: 15px 5px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: {{ section.settings.alignment }};
  }
  .product-title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }
  .product-title a {
    color: #222;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .product-title a:hover {
    color: #000;
    text-decoration: underline;
  }
  .product-price {
    font-size: 15px;
    font-weight: 600;
    color: #333;
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: {% if section.settings.alignment == 'center' %}center{% elsif section.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  .compare-price {
    font-size: 13px;
    text-decoration: line-through;
    color: #999;
    font-weight: 400;
  }
  .pagination {
    margin: 30px 0 60px;
    text-align: center;
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .pagination a, .pagination .current {
    padding: 8px 16px;
    text-decoration: none;
    border: 1px solid #ddd;
    color: #333;
    border-radius: 4px;
  }
  .pagination .current {
    background-color: #000;
    color: #fff;
    border-color: #000;
  }
{% endstyle %}

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
        "type": "range",
        "id": "products_per_page",
        "label": "Products per page",
        "default": 12,
        "min": 1,
        "max": 20,
        "step": 1
    },
    {
        "type": "range",
        "id":"width",
        "label":"Width",
        "default":1200,
        "min":100,
        "max":2000,
        "step":50,
        "unit":"px"
    },
    {
        "type": "range",
        "id":"grid_column",
        "label":"Grid Column",
        "default":3,
        "min":1,
        "max":12,
        "step":1
    },
    {
        "type": "select",
        "id":"alignment",
        "label":"Alignment",
        "options":[
            {
                "value":"left",
                "label":"Left"
            },
            {
                "value":"center",
                "label":"Center"
            },
            {
                "value":"right",
                "label":"Right"
            }
        ],
        "default":"left"
    }
    
  ]
}
{% endschema %}